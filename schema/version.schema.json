{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TinyTrash Update Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "revision",
    "issued_at",
    "expires_at",
    "platforms"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "app_id": {
      "type": "string",
      "const": "com.ursastack.tinytrash"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ios",
        "android"
      ],
      "properties": {
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "minimum_version",
            "minimum_build"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minimum_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
            },
            "minimum_build": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$",
              "description": "Additional numeric maximum 2147483647 is enforced by validate.py."
            }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "minimum_version",
            "minimum_build"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minimum_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
            },
            "minimum_build": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$",
              "description": "Additional numeric maximum 2147483647 is enforced by validate.py."
            }
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$comment": "validate.py additionally enforces duplicate-key rejection, UTF-8/size, strict integer lexical types, real UTC dates, freshness and a maximum seven-day lifetime."
}
